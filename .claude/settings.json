{
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/report-tests.mjs\"",
            "timeout": 120,
            "statusMessage": "npm test 확인 중..."
          }
        ]
      }
    ]
  }
}
